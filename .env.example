# Copy to .env and adjust. Every value here is optional: on first start the app
# generates its encryption key and writes it into .env.

# --- WhatsApp connection ---------------------------------------------------
# Which provider carries the messages.
#   baileys - unofficial WhatsApp Web client. No per-message cost, links by QR,
#             outside WhatsApp's terms of service. See COMPLIANCE.md.
WHATSAPP_PROVIDER=baileys

# --- Dashboard -------------------------------------------------------------
# Bind address. Loopback by default; the dashboard holds customer
# conversations and a live WhatsApp session, so put TLS in front of it before
# exposing it.
HOST=127.0.0.1
PORT=3000

# Set your own dashboard password. On the next start it is hashed into
# ADMIN_PASSWORD_HASH and this line is removed automatically. Leave it unset
# and one is generated and printed once on the first run.
# ADMIN_PASSWORD=

# Set both to true when a reverse proxy terminates TLS in front of the app.
TRUST_PROXY=false
COOKIE_SECURE=false

# Hours before a dashboard sign-in expires.
SESSION_TTL_HOURS=12

# --- Privacy ---------------------------------------------------------------
# Conversation history older than this is deleted automatically.
MESSAGE_RETENTION_DAYS=30

# Where the SQLite database and WhatsApp credentials live.
# DATA_DIR=./data
# Where generated secrets are written (defaults to ./.env next to the app).
# ENV_FILE=./.env

# --- Behaviour -------------------------------------------------------------
# Short pause that lets a burst of messages typed in one breath become a
# single answer. Not the reply delay - that is next.
INBOUND_DEBOUNCE_MS=3000

# How long a customer waits before the reply lands. A fresh random value every
# time, weighted towards the quick end so it reads like a person with a phone
# in their hand. Never faster than the minimum, never slower than the maximum.
REPLY_DELAY_MIN_MS=3000
REPLY_DELAY_MAX_MS=60000

# How the account presents its availability to contacts.
#   reactive - offline by default, online only while handling a reply, then
#              offline again after a short linger. Closest to a real person.
#   online   - always online. Last-seen never moves; the obvious bot tell.
#   offline  - never announce availability at all.
PRESENCE_MODE=reactive

# How long to stay online after finishing, like someone who has not yet put
# their phone down.
PRESENCE_LINGER_MIN_MS=5000
PRESENCE_LINGER_MAX_MS=25000

# The beat between the chat being opened (blue ticks) and typing starting.
READ_GAP_MIN_MS=400
READ_GAP_MAX_MS=2500

# The "typing..." indicator shown at the end of that wait.
TYPING_BASE_MS=700
TYPING_PER_CHAR_MS=45
TYPING_MAX_MS=8000

# Notes kept about each customer: rewritten every this many messages, and
# capped at this many characters.
MEMORY_UPDATE_EVERY=6
MAX_MEMORY_CHARS=1200
# Number of past messages sent to the model as context.
HISTORY_LIMIT=24
# Hard caps on message sizes.
MAX_REPLY_CHARS=1200
MAX_INBOUND_CHARS=4000
# How long to wait for the model before giving up.
LLM_TIMEOUT_MS=60000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
# Baileys' own logs; 'debug' when diagnosing connection problems.
WA_LOG_LEVEL=silent

# --- Generated automatically, do not set by hand ---------------------------
# ENCRYPTION_KEY      encrypts the stored OpenRouter key
# SESSION_SECRET      signs dashboard CSRF tokens
# ADMIN_PASSWORD_HASH the dashboard password, hashed with scrypt
